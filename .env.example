DATABASE_URL=postgresql+psycopg://replace-with-user:replace-with-password@localhost:5433/orderflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_DB=orderflow
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
RABBITMQ_URL=amqp://replace-with-user:replace-with-password@localhost:5672/
RABBITMQ_USER=replace-with-a-rabbitmq-user
RABBITMQ_PASSWORD=replace-with-a-rabbitmq-password
REDIS_URL=redis://localhost:6379/0
WEBHOOK_SECRET=replace-with-at-least-32-character-webhook-secret
